# PRODUCTION settings for Cloudflare. Copy to `production.secrets`, fill in,
# then upload them all at once with:
#     npx wrangler secret bulk production.secrets
# `production.secrets` is ignored by git. NEVER commit or share it.
# (SMS_DRY_RUN is NOT set here: it lives in wrangler.jsonc "vars".)

# Your app's public address (printed by `npm run deploy`), no trailing slash
NEXT_PUBLIC_SITE_URL=https://church-sms.YOUR-SUBDOMAIN.workers.dev

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nalo
# Nalo login: EITHER an API key (from the Nalo client portal)...
NALO_API_KEY=
# ...OR your Nalo username + password (used only if NALO_API_KEY is empty)
NALO_USERNAME=
NALO_PASSWORD=
NALO_SENDER_ID=
# Only if Nalo gives you a different address than the default:
# NALO_API_URL=

# Long random password; use the SAME value for the scheduler worker
CRON_SECRET=

# Cloudflare dashboard -> Turnstile -> your widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
