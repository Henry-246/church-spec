# Copy this file to `.dev.vars` for local development and fill in the values.
# NEVER commit `.dev.vars`. In production, set these on Cloudflare instead
# (see README, "Environment variables"). Keep comments on their own lines.

# Public address of the app, e.g. https://join.mychurch.org (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only - keep secret!
SUPABASE_SERVICE_ROLE_KEY=

# Nalo Solutions SMS. Keys/passwords are server only - keep secret!
# Nalo login: EITHER an API key (from the Nalo client portal)...
NALO_API_KEY=
# ...OR your Nalo username + password (used only if NALO_API_KEY is empty)
NALO_USERNAME=
NALO_PASSWORD=
NALO_SENDER_ID=
# true = record messages but send nothing (safe for testing). false = send real SMS.
SMS_DRY_RUN=true
# Optional: Nalo endpoint (confirm with Nalo). Default:
# NALO_API_URL=https://sms.nalosolutions.com/smsbackend/Resl_Nalo/send-message/
# Optional: SMS sent per queue run (default 20, max 40)
# QUEUE_BATCH_SIZE=20

# Long random string shared with the scheduler worker (workers/scheduler)
CRON_SECRET=

# Cloudflare Turnstile. These are Cloudflare's official always-pass TEST keys,
# fine for local development. Replace with your real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# APP_URL is only used by the scheduler worker: see workers/scheduler/.dev.vars.example
